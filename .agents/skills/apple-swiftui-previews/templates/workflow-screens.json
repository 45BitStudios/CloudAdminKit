{
  "data": {
    "type": "ciWorkflows",
    "attributes": {
      "name": "Screens",
      "description": "Render SwiftUI design screenshots (light + dark) from the Screens scheme. PNGs land in Designs/previews and the result bundle.",
      "isEnabled": true,
      "isLockedForEditing": false,
      "clean": false,
      "containerFilePath": "{{XCODEPROJ_DIR}}/{{XCODEPROJ_FILENAME}}",
      "pullRequestStartCondition": {
        "source": { "isAllMatch": true },
        "destination": {
          "isAllMatch": false,
          "patterns": [ { "pattern": "main", "isPrefix": false } ]
        },
        "autoCancel": true
      },
      "manualBranchStartCondition": {
        "source": { "isAllMatch": true }
      },
      "actions": [
        {
          "name": "Build - macOS",
          "actionType": "BUILD",
          "scheme": "Screens",
          "platform": "MACOS",
          "destination": "ANY_MAC",
          "isRequiredToPass": true
        }
      ]
    },
    "relationships": {
      "xcodeVersion": { "data": { "type": "ciXcodeVersions", "id": "{{XCODE_VERSION_ID}}" } },
      "macOsVersion": { "data": { "type": "ciMacOsVersions", "id": "{{XCODE_VERSION_ID}}" } },
      "product": { "data": { "type": "ciProducts", "id": "{{PRODUCT_ID}}" } },
      "repository": { "data": { "type": "scmRepositories", "id": "{{REPOSITORY_ID}}" } }
    }
  }
}
